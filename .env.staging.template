AUTO_LOCK_MINUTES=5
SESSION_TIMEOUT_HOURS=24

GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

SYNC_RETRY_BASE_SECONDS=30
SYNC_MAX_RETRY_HOURS=24
