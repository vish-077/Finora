APP_ENV=staging
APP_NAME=FINORA Staging
APP_VERSION=1.0.0


LOG_LEVEL=info
ENABLE_TALKER_OVERLAY=false

FEATURE_AI_BOX=true
FEATURE_RECEIPT_SCANNER=true
